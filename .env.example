# Copy to .env locally and fill in your own development values.
# Never commit .env or real credentials.

APP_ENV=development
LOG_LEVEL=INFO

# Analytical PostgreSQL database
PGHOST=localhost
PGPORT=5432
PGDATABASE=supply_planning_lab
PGUSER=supply_planning_app
PGPASSWORD=change_me_locally

# Optional Odoo test instance; leave blank until the ERP phase.
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=
