# Copy to .env locally and fill in your own development values.
# Never commit .env or real credentials.

APP_ENV=development
LOG_LEVEL=INFO

# Analytical PostgreSQL database
# If 5432 already runs a PostgreSQL server for other work on your machine,
# use a separate instance or port instead (this project's own dev instance
# runs on 5433 for exactly that reason — see README.md "Getting started").
PGHOST=localhost
PGPORT=5432
PGDATABASE=supply_planning_lab
PGUSER=supply_planning_app
PGPASSWORD=change_me_locally

# Optional Odoo test instance; leave blank until the ERP phase.
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=
